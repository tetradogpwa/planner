# ─────────────────────────────────────────────────────────────────────
# Planificador Semanal — variables de entorno (plantilla)
# ─────────────────────────────────────────────────────────────────────
# Copia este archivo a `.env` (en la raíz del repo, NO al repositorio)
# y rellena los valores que correspondan.
#
# .env está incluido en .gitignore. NUNCA subas el archivo real con
# claves; el `.env.example` es solo una plantilla pública.
# ─────────────────────────────────────────────────────────────────────

# ── Monetización ────────────────────────────────────────────────────
# Las claves se INCRUSTAN EN COMPILACIÓN (src-tauri/build.rs): tras
# cambiarlas hay que recompilar. Una variable de entorno del proceso
# (p. ej. un secret del CI) tiene prioridad sobre este archivo.
#
# Cada build solo usa las de su plataforma (src-tauri/src/ads.rs):
#   Linux / Windows → AdSense dentro del WebView
#   Android         → AdMob nativo (plugin src-tauri/plugins/tauri-plugin-admob)
#
# Si las de la plataforma están vacías, esa build no muestra anuncios.
#
# SIN ninguna clave de anuncios, la build FALLA (src-tauri/build.rs):
# no se publica una app sin monetizar ni sin aviso. Si de verdad quieres
# una build sin anuncios (la versión de pago, las pruebas o una build
# interna), pon ALLOW_NO_ADS=1: es un permiso explícito.
#
# Estos IDs no son secretos (acaban dentro de la app publicada).

# Escritorio (AdSense)
# GOOGLE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# GOOGLE_ADSENSE_SLOT=YYYYYYYYYY

# Android (AdMob)
# GOOGLE_ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
# GOOGLE_ADMOB_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
# GOOGLE_ADMOB_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/WWWWWWWWWW

# Anuncios de prueba (AdSense: data-adtest; AdMob: unidades de test de
# Google). Si no se define: true en builds debug, false en release.
# ADS_TEST_MODE=true

# Estado por defecto del flag "anuncios quitados". Útil para
# compilaciones internas donde se quiere forzar un estado.
# Valores aceptados: true | false (por defecto: false).
# ADS_REMOVED_DEFAULT=false

# Versión de pago ("consentimiento o pago"). Si el usuario rechaza los
# anuncios, la app se bloquea y le ofrece este enlace. Compila la
# versión de pago SIN claves de anuncios: así no muestra ni anuncios
# ni la pantalla de consentimiento.
# PAID_VERSION_URL_DESKTOP=https://tu-web.example/planner-pro
# PAID_VERSION_URL_ANDROID=https://play.google.com/store/apps/details?id=tu.paquete.pro

# Permiso explícito para compilar SIN claves de anuncios. Déjalo
# DESCOMENTADO solo si es una build que va a propósito sin anuncios
# (la versión de pago, las pruebas o una build interna). Con el
# comentario tal como está, una build sin claves de anuncios falla.
# ALLOW_NO_ADS=1

# ── Microsoft Store / MSIX ──────────────────────────────────────────
# Estos campos rellenarán los placeholders [TU_*] en
# src-tauri/tauri.conf.json y src-tauri/capabilities/*.json.
# NO son leídos por el código Rust directamente: Tauri CLI los
# lee de `tauri.conf.json`, no de .env.

# MSIX_CERT_THUMBPRINT=‎[hash hexadecimal sin espacios]
# MSIX_CERT_SUBJECT="CN=Gabriel Cat Developer"

# ── Google Play / Android ───────────────────────────────────────────
# Tauri 2 will use these to fill in the AndroidManifest.xml. The
# primary "release key" is managed from the Play Console, not here.

# ANDROID_KEYSTORE_PATH=/ruta/al/keystore.jks
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
# ── MiniMax (desarrollador supervisado por Claude) ──────────────────
# MiniMax trabaja con OpenCode: tools/minimax/run-task.sh lanza
# `opencode run --agent planner-worker` (permisos en opencode.json).
# La clave NO va aquí: conéctala una vez con `opencode auth login`.
# Comprueba todo con: bash tools/minimax/run-task.sh --check
#
# Modelo en formato de OpenCode (lista: opencode models | grep minimax).
# MINIMAX_MODEL=minimax/MiniMax-M3
#
# Tiempo máximo por tarea, en segundos.
# MINIMAX_TIMEOUT=3600
#
# Ruta de OpenCode si no está en el PATH.
# OPENCODE_BIN=~/.opencode/bin/opencode
