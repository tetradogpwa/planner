{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos por defecto de Planificador Semanal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-title",
    "core:webview:default",
    "core:event:default",
    "core:app:default",
    "core:path:default",

    "shell:allow-open",

    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}