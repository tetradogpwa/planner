{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos por defecto de Planificador Semanal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-title",
    "core:webview:default",
    "core:event:default",
    "core:app:default",
    "core:path:default",

    "shell:allow-open",

    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-message",

    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        "$DOCUMENT/**",
        "$DOWNLOAD/**",
        "$DESKTOP/**",
        "$APPDATA/**",
        "$APPLOCALDATA/**"
      ]
    },

    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}