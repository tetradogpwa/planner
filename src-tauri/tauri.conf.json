{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Planificador Semanal",
  "version": "0.1.0",
  "identifier": "gabriel.cat.developer.planner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": null,
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Planificador Semanal",
        "label": "main",
        "width": 1100,
        "height": 760,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "zoomHotkeysEnabled": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri:; img-src 'self' data: tauri: asset:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; frame-src 'none'; connect-src 'self' tauri: ipc:"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Gabriel Cat Developer",
    "category": "Productivity",
    "shortDescription": "Planificador local de tareas y hábitos",
    "longDescription": "Planificador semanal con tareas recurrentes, ciclos personalizados y exportación a PDF. Funciona 100% local; sin servidor ni cuentas.",
    "copyright": "© 2026 Gabriel Cat Developer",
    "targets": ["appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {

      "../legal/PRIVACY.md": "legal/PRIVACY.md",
      "../legal/TERMS.md": "legal/TERMS.md",
      "../legal/EULA.md": "legal/EULA.md",
      "../legal/COOKIES.md": "legal/COOKIES.md",
      "../legal/ACCESSIBILITY.md": "legal/ACCESSIBILITY.md",
      "../legal/ACCEPTABLE_USE.md": "legal/ACCEPTABLE_USE.md",
      "../legal/CONTACT.md": "legal/CONTACT.md",
      "../legal/THIRD_PARTY_LICENSES.md": "legal/THIRD_PARTY_LICENSES.md"
    },
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1
    },
    "windows": {
      "certificateThumbprint": "[TU_THUMBPRINT_CERTIFICADO_NSIS]",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0"]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": "https://.*"
    }
  }
}