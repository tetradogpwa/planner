{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "planner-worker": {
      "description": "Desarrollador (MiniMax) de las tareas del Planificador; lo lanza tools/minimax/run-task.sh y lo supervisa Claude",
      "mode": "primary",
      "model": "minimax/MiniMax-M3",
      "permission": {
        "*": "allow",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "edit": {
          "*": "allow",
          "*.tasks/*": "deny",
          "*.claude/*": "deny",
          "*.env": "deny",
          "*.env.*": "deny",
          "*CLAUDE.md": "deny",
          "*AGENTS.md": "deny",
          "*opencode.json": "deny"
        },
        "bash": {
          "*": "allow",
          "git commit*": "deny",
          "git push*": "deny",
          "git reset*": "deny",
          "git checkout*": "deny",
          "git switch*": "deny",
          "git restore*": "deny",
          "git stash*": "deny",
          "git clean*": "deny",
          "git rebase*": "deny",
          "rm -rf*": "deny",
          "node tools/tasks/*": "deny",
          "bash tools/minimax/*": "deny",
          "*run-task.sh*": "deny"
        },
        "skill": "deny",
        "question": "deny",
        "external_directory": "deny",
        "doom_loop": "deny"
      }
    }
  }
}
